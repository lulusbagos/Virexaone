# ==========================================
# Comprehensive .gitignore for Virexa Project
# (Unity 3D + .NET Backend + Node.js + Flutter + Python)
# ==========================================

# ------------------------------------------
# 1. Unity Project Files & Cache
# ------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

**/Library/
**/Temp/
**/Obj/
**/Build/
**/Builds/
**/Logs/
**/UserSettings/
**/MemoryCaptures/
**/Recordings/

# Asset store packages
[Aa]ssets/AssetStoreTools*

# Autogenerated VS/VSCode/Rider solution and project files
ExportedObj/
.consulo/
/*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.opendb
*.VC.db

# Unity crashlytics
sysinfo.txt
crashlytics-build.properties

# ------------------------------------------
# 2. .NET / C# Backend
# ------------------------------------------
**/bin/
**/obj/
*.user
*.userosscache
*.sln.docstates
appsettings.Development.json
**/appsettings.Local.json

# ------------------------------------------
# 3. Node.js & Server
# ------------------------------------------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ------------------------------------------
# 4. Flutter & Mobile
# ------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/flutter_*.png

# ------------------------------------------
# 5. Python
# ------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# ------------------------------------------
# 6. OS & IDE Specific
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.bak
*.7z
/Assets/_Recovery/
